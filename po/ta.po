msgid "Write to %s Failed"
msgstr "%sக்கு எழுதுவது தோல்வியடைந்தது"

#, c-format
msgid "The Folder Link '%s' is Not Valid."
msgstr "கோப்புறை இணைப்பு '%s' தவறானது."

#, c-format
msgid "The File Link '%s' is Not Valid."
msgstr "கோப்பு இணைப்பு '%s' தவறானது."

#, c-format
msgid "The Folder Link '%s' is Not Valid"
msgstr "கோப்புறை இணைப்பு '%s' தவறானது"

#, c-format
msgid "The Link Refers to a Node that Does Not Exist Anymore (Id = %s)"
msgstr "இணைப்பு இனி இல்லாத ஒரு முனையைக் குறிக்கிறது (ஐடி = %s)"

#, c-format
msgid "No anchor named '%s' found"
msgstr "'%s' என்ற பெயரில் எந்த அறிவிப்பையும் காணவில்லை"

msgid "Edit CodeBox"
msgstr "குறியீட்டுபெட்டியை திருத்து"

#, c-format
msgid ""
"You must associate a command to '%s'.\n"
"Do so in the Preferences Dialog."
msgstr ""
"நீங்கள் ஒரு கட்டளையை '%s' உடன் இணைக்க வேண்டும். \n"
"விருப்பத்தேர்வுகள் உரையாடலில் அவ்வாறு செய்யவும்."

msgid ""
"Install the package 'xterm' or configure a different terminal in the "
"Preferences Dialog."
msgstr ""
"'xterm' தொகுப்பை நிறுவவும் அல்லது விருப்பத்தேர்வுகள் உரையாடலில் வேறு "
"முனையத்தை உள்ளமைக்கவும்."

msgid "Edit Table Properties"
msgstr "அட்டவணை பண்புகளைத் திருத்தவும்"

msgid "Insert Anchor"
msgstr "ஆங்கரைச் செருகவும்"

msgid "Edit Anchor"
msgstr "ஆங்கரைத் திருத்து"

msgid "Cannot Edit Embedded File in Read Only Node."
msgstr "படிக்க மட்டும் முனையில் உட்பொதிக்கப்பட்ட கோப்பைத் திருத்த முடியாது."

msgid "Embedded File Automatically Updated:"
msgstr "உட்பொதிக்கப்பட்ட கோப்பு தானாகவே புதுப்பிக்கப்பட்டது:"

msgid "No Node is Selected"
msgstr "எந்த முனையும் தேர்ந்தெடுக்கப்படவில்லை"

msgid "The Tree is Empty!"
msgstr "மரம் காலி!"

msgid "The Selected Node is Read Only."
msgstr "தேர்ந்தெடுக்கப்பட்ட முனை படிக்க மட்டுமே."

msgid "This Feature is Available Only in Rich Text Nodes."
msgstr "இந்த நற்பொருத்தம் மிகை உரை முனைகளில் மட்டுமே கிடைக்கும்."

msgid "This Feature is Not Available in Automatic Syntax Highlighting Nodes."
msgstr "இந்த நற்பொருத்தம் தானியங்கி தொடரியல் தனிப்படுத்தல் முனைகளில் இல்லை."

msgid "No Table is Selected."
msgstr "எந்த அட்டவணையும் தேர்ந்தெடுக்கப்படவில்லை."

msgid "No CodeBox is Selected."
msgstr "குறியீட்டுபெட்டி எதுவும் தேர்ந்தெடுக்கப்படவில்லை."

msgid "New Child Node Properties"
msgstr "புதிய குழந்தை முனை பண்புகள்"

msgid "New Node Properties"
msgstr "புதிய முனை பண்புகள்"

msgid "Node Properties"
msgstr "முனை பண்புகள்"

msgid ""
"Changing the node type to Automatic Syntax Highlighting removes all rich "
"text formatting in this node. Do you want to Continue?"
msgstr ""
"முனை வகையை தானியங்கி தொடரியல் சிறப்பம்சமாக மாற்றுவது இந்த முனையில் உள்ள "
"அனைத்து பணக்கார உரை வடிவமைப்பையும் நீக்குகிறது. நீங்கள் தொடர "
"விரும்புகிறீர்களா?"

#, c-format
msgid "Are you sure to <b>Delete the node '%s'?</b>"
msgstr "<b>'%s' முனையை நீக்குவது உறுதி?</b>"

msgid "The node <b>has Children, they will be Deleted too!</b>"
msgstr "முனையில் <b>குழந்தைகள் உள்ளனர், அவர்களும் நீக்கப்படுவார்கள்!</b>"

msgid "Select the New Parent"
msgstr "புதிய பெற்றோரைத் தேர்ந்தெடுக்கவும்"

msgid "The new parent can't be the very node to move!"
msgstr "புதிய பெற்றோர் நகரும் முனையாக இருக்க முடியாது!"

msgid "The new chosen parent is still the old parent!"
msgstr "புதிதாக தேர்ந்தெடுக்கப்பட்ட பெற்றோர் இன்னும் பழைய பெற்றோரே!"

msgid "The new parent can't be one of his children!"
msgstr "புதிய பெற்றோர் அவரது குழந்தைகளில் ஒருவராக இருக்க முடியாது!"

#, c-format
msgid "%s Nodes Properties Changed"
msgstr "%s முனைகளின் பண்புகள் மாற்றப்பட்டன"

msgid ""
"The Number of Last Visited Nodes on Node Name Header is already at the "
"Maximum Value."
msgstr ""
"முனையின் பெயர் தலைப்பில் கடைசியாகப் பார்வையிட்ட முனைகளின் எண்ணிக்கை ஏற்கனவே "
"அதிகபட்ச மதிப்பில் உள்ளது."

msgid ""
"The Number of Last Visited Nodes on Node Name Header is already at the "
"Minimum Value."
msgstr ""
"முனையின் பெயர் தலைப்பில் கடைசியாகப் பார்வையிட்ட முனைகளின் எண்ணிக்கை ஏற்கனவே "
"குறைந்தபட்ச மதிப்பில் உள்ளது."

msgid "The Size of the Toolbar Icons is already at the Maximum Value."
msgstr "கருவிப்பட்டி ஐகான்களின் அளவு ஏற்கனவே அதிகபட்ச மதிப்பில் உள்ளது."

msgid "The Size of the Toolbar Icons is already at the Minimum Value."
msgstr "கருவிப்பட்டி ஐகான்களின் அளவு ஏற்கனவே குறைந்தபட்ச மதிப்பில் உள்ளது."

msgid "Print CherryTree version"
msgstr "செர்ரிமர பதிப்பை அச்சிடுங்கள்"

msgid "Node name to focus"
msgstr "கவனம் செலுத்த முனை பெயர்"

msgid "Anchor name to scroll to in node"
msgstr "முனையில் உருட்ட வேண்டிய ஆங்கர் பெயர்"

msgid "Export to HTML at specified directory path"
msgstr "குறிப்பிட்ட அடைவு பாதையில் HTML க்கு ஏற்றுமதி செய்யவும்"

msgid "Export to Text at specified directory path"
msgstr "குறிப்பிட்ட அடைவு பாதையில் உரைக்கு ஏற்றுமதி செய்யவும்"

msgid "Export to PDF at specified directory path"
msgstr "குறிப்பிட்ட அடைவு பாதையில் PDF க்கு ஏற்றுமதி செய்யவும்"

msgid "Overwrite if export path already exists"
msgstr "ஏற்றுமதி பாதை ஏற்கனவே இருந்தால் மேலெழுதவும்"

msgid "Export to a single file (for HTML or TXT)"
msgstr "ஒரு கோப்பிற்கு ஏற்றுமதி செய்யவும் (HTML அல்லது TXTக்கு)"

msgid "Password to open document"
msgstr "ஆவணத்தைத் திறப்பதற்கான கடவுச்சொல்"

msgid "Create a new window"
msgstr "புதிய சாளரத்தை உருவாக்கவும்"

msgid "Run in secondary session, independent from main session"
msgstr "முதன்மை அமர்வில் இருந்து சுயாதீனமாக இரண்டாம் நிலை அமர்வில் இயக்கவும்"

msgid "Execute Code"
msgstr "குறியீட்டை இயக்கவும்"

msgid "Copy Code"
msgstr "நகல் குறியீடு"

msgid "Change CodeBox Properties"
msgstr "CodeBox பண்புகளை மாற்றவும்"

msgid "Start in CherryTree"
msgstr "செர்ரி மரத்தில் தொடங்குங்கள்"

msgid "New Document"
msgstr "புதிய ஆவணம்"

msgid "Open File"
msgstr "கோப்பை திற"

msgid "Open Folder"
msgstr "கோப்புறையைத் திறக்கவும்"

msgid "Create a new document or open an existing one."
msgstr "புதிய ஆவணத்தை உருவாக்கவும் அல்லது ஏற்கனவே உள்ள ஒன்றைத் திறக்கவும்."

msgid "Don't show again"
msgstr "மீண்டும் காட்டாதே"

msgid "Recent Documents"
msgstr "சமீபத்திய ஆவணங்கள்"

msgid "Name"
msgstr "பெயர்"

msgid "Path"
msgstr "பாதை"

msgid "Open Selected"
